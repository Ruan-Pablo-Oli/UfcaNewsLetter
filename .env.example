# Copie este arquivo para ".env" e ajuste os valores conforme o ambiente.
# NUNCA versione o arquivo ".env" (ele já está no .gitignore).

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL
POSTGRES_DB=ufcanewsletter
POSTGRES_USER=ufcanewsletter
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Web Push (VAPID) — notificações push (issue #22)
# Gere o par de chaves localmente com `vapid --gen` (instalado junto com pywebpush)
# e cole aqui as chaves em base64 URL-safe geradas em vapid_private_key.pem/.pub.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:contato@ufca.edu.br

# E-mail do digest (issue #24)
# Padrão: backend de console — o e-mail sai no log do contêiner, sem SMTP.
# Para enviar de verdade, troque por django.core.mail.backends.smtp.EmailBackend
# e preencha host/porta/credenciais.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=UFCA Newsletter <noreply@ufca.edu.br>

# Agendador (ADR-008): de quanto em quanto tempo o serviço `scheduler` executa
# o ciclo coletar -> enviar_digest -> notificar_push, em segundos.
SCHEDULER_INTERVALO_SEGUNDOS=900
